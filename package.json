{
  "name": "magnum-addons",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Stremio-protocol addons for Magnum Opus",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22",
    "typescript": "~6.0.3"
  }
}
